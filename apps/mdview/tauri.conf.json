{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdview",
  "version": "0.1.0",
  "identifier": "com.mdview.app",
  "build": {
    "frontendDist": "webview/dist"
  },
  "app": {
    "windows": [
      {
        "title": "mdview",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": false,
        "fileDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob: http://127.0.0.1:* ws://127.0.0.1:*"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "identifier": "com.mdview.app",
    "icon": [],
    "category": "DeveloperTool",
    "shortDescription": "Modern Markdown renderer",
    "longDescription": "mdview — lightweight, extensible markdown renderer with Tauri desktop, terminal pager, and Neovim live preview."
  },
  "plugins": {}
}
