    <span style="color:#e5c07b;">println!</span><span style="color:inherit;"><span style="color:inherit;">(</span></span><span style="color:inherit;"><span style="color:#98c379;"><span style="color:#98c379;">&quot;</span><span style="color:#d19a66;">{msg}</span><span style="color:#98c379;">&quot;</span></span></span><span style="color:inherit;"><span style="color:inherit;">)</span></span><span style="color:inherit;">;</span>
