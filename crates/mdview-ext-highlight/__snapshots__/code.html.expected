<!doctype html>
<html><head><meta charset="utf-8"><title>code demo</title><style>body{font-family:ui-sans-serif,system-ui;padding:24px;background:#fafafa;}pre.mdv-code{border-radius:12px;padding:16px;background:#f4f4f5;box-shadow:0 1px 2px rgba(0,0,0,0.08);overflow:auto;}code{font-family:ui-monospace,Menlo,Consolas,monospace;}</style></head><body>
<pre class="mdv-code" data-lang="rust"><code><span class="mdv-tok"><span class="mdv-tok mdv-tok-keyword">use</span> <span class="mdv-tok">std<span class="mdv-tok">::</span></span><span class="mdv-tok">collections<span class="mdv-tok">::</span></span>BTreeMap<span class="mdv-tok">;</span>

<span class="mdv-tok mdv-tok-function"><span class="mdv-tok mdv-tok-function"><span class="mdv-tok mdv-tok-function">fn</span> </span><span class="mdv-tok mdv-tok-function">main</span></span><span class="mdv-tok mdv-tok-function"><span class="mdv-tok mdv-tok-function"><span class="mdv-tok">(</span></span><span class="mdv-tok mdv-tok-function"><span class="mdv-tok mdv-tok-function"><span class="mdv-tok">)</span></span></span></span><span class="mdv-tok mdv-tok-function"> </span><span class="mdv-tok mdv-tok-function"><span class="mdv-tok"><span class="mdv-tok">{</span>
    <span class="mdv-tok mdv-tok-type">let</span> <span class="mdv-tok mdv-tok-keyword">mut</span> m<span class="mdv-tok">:</span> <span class="mdv-tok">BTreeMap<span class="mdv-tok">&lt;</span><span class="mdv-tok mdv-tok-keyword">&amp;</span><span class="mdv-tok mdv-tok-type">str</span>, <span class="mdv-tok mdv-tok-type">i32</span><span class="mdv-tok">&gt;</span></span> <span class="mdv-tok mdv-tok-keyword">=</span> <span class="mdv-tok">BTreeMap<span class="mdv-tok">::</span></span>new<span class="mdv-tok"><span class="mdv-tok">(</span></span><span class="mdv-tok"><span class="mdv-tok">)</span></span><span class="mdv-tok">;</span>
    m.<span class="mdv-tok mdv-tok-function">insert</span><span class="mdv-tok"><span class="mdv-tok">(</span><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span>curvy<span class="mdv-tok mdv-tok-string">&quot;</span></span><span class="mdv-tok">,</span> <span class="mdv-tok mdv-tok-constant">42</span></span><span class="mdv-tok"><span class="mdv-tok">)</span></span><span class="mdv-tok">;</span>
    <span class="mdv-tok mdv-tok-keyword">for</span> <span class="mdv-tok"><span class="mdv-tok">(</span>k<span class="mdv-tok">,</span> v</span><span class="mdv-tok"><span class="mdv-tok">)</span></span> <span class="mdv-tok mdv-tok-keyword">in</span> <span class="mdv-tok mdv-tok-keyword">&amp;</span>m <span class="mdv-tok"><span class="mdv-tok">{</span>
        <span class="mdv-tok mdv-tok-type">println!</span><span class="mdv-tok"><span class="mdv-tok">(</span></span><span class="mdv-tok"><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span>╭ <span class="mdv-tok mdv-tok-constant">{k}</span> = <span class="mdv-tok mdv-tok-constant">{v}</span> ╮<span class="mdv-tok mdv-tok-string">&quot;</span></span></span><span class="mdv-tok"><span class="mdv-tok">)</span></span><span class="mdv-tok">;</span>
    </span><span class="mdv-tok"><span class="mdv-tok">}</span></span>
</span><span class="mdv-tok"><span class="mdv-tok">}</span></span></span>
</span></code></pre>
<pre class="mdv-code" data-lang="ts"><code><span class="mdv-tok">interface Theme {
  name: string;
  radii: { sm: number; md: number; lg: number };
}

export const dark: Theme = {
  name: &quot;dark&quot;,
  radii: { sm: 6, md: 10, lg: 16 },
};
</span></code></pre>
<pre class="mdv-code" data-lang="python"><code><span class="mdv-tok"><span class="mdv-tok mdv-tok-function"><span class="mdv-tok mdv-tok-function">def</span> <span class="mdv-tok mdv-tok-function"><span class="mdv-tok">greet</span></span></span><span class="mdv-tok mdv-tok-function"><span class="mdv-tok">(</span></span><span class="mdv-tok mdv-tok-function"><span class="mdv-tok mdv-tok-function">name</span></span><span class="mdv-tok mdv-tok-function"><span class="mdv-tok">:</span> <span class="mdv-tok"><span class="mdv-tok mdv-tok-type">str</span></span></span><span class="mdv-tok mdv-tok-function"><span class="mdv-tok">)</span></span><span class="mdv-tok mdv-tok-function"> </span><span class="mdv-tok mdv-tok-function"><span class="mdv-tok">-&gt;</span> <span class="mdv-tok"><span class="mdv-tok mdv-tok-type">str</span></span></span><span class="mdv-tok mdv-tok-function"><span class="mdv-tok mdv-tok-function">:</span></span>
    <span class="mdv-tok mdv-tok-keyword">return</span> <span class="mdv-tok mdv-tok-string">f</span><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span></span></span><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">hello, </span><span class="mdv-tok"><span class="mdv-tok">{</span><span class="mdv-tok"><span class="mdv-tok"><span class="mdv-tok">name</span></span></span></span><span class="mdv-tok"><span class="mdv-tok">}</span></span><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span></span></span>

<span class="mdv-tok"><span class="mdv-tok mdv-tok-keyword">if</span> <span class="mdv-tok"><span class="mdv-tok mdv-tok-function">__name__</span></span> <span class="mdv-tok mdv-tok-keyword">==</span> <span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span></span></span><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">__main__<span class="mdv-tok mdv-tok-string">&quot;</span></span></span><span class="mdv-tok">:</span></span>
    <span class="mdv-tok"><span class="mdv-tok"><span class="mdv-tok mdv-tok-function">print</span></span><span class="mdv-tok">(</span><span class="mdv-tok"><span class="mdv-tok"><span class="mdv-tok"><span class="mdv-tok mdv-tok-function">greet</span></span><span class="mdv-tok">(</span><span class="mdv-tok"><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span></span></span><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">world<span class="mdv-tok mdv-tok-string">&quot;</span></span></span></span><span class="mdv-tok">)</span></span></span><span class="mdv-tok">)</span></span>
</span></code></pre>
<pre class="mdv-code" data-lang="bash"><code><span class="mdv-tok"><span class="mdv-tok mdv-tok-comment"><span class="mdv-tok mdv-tok-comment">#</span></span><span class="mdv-tok mdv-tok-comment">!/usr/bin/env bash</span><span class="mdv-tok mdv-tok-comment">
</span><span class="mdv-tok"><span class="mdv-tok mdv-tok-function">set</span></span><span class="mdv-tok"> -euo pipefail</span>
<span class="mdv-tok mdv-tok-keyword">for</span><span class="mdv-tok"> f <span class="mdv-tok mdv-tok-keyword">in</span> fixtures/<span class="mdv-tok mdv-tok-keyword">*</span>.md</span><span class="mdv-tok mdv-tok-keyword">;</span> <span class="mdv-tok mdv-tok-keyword">do</span>
  <span class="mdv-tok"><span class="mdv-tok mdv-tok-function">echo</span></span><span class="mdv-tok"> <span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span>╭── <span class="mdv-tok"><span class="mdv-tok mdv-tok-function">$</span><span class="mdv-tok mdv-tok-function">f</span></span> ──╮<span class="mdv-tok mdv-tok-string">&quot;</span></span></span>
  <span class="mdv-tok"><span class="mdv-tok mdv-tok-function">wc</span></span><span class="mdv-tok"><span class="mdv-tok mdv-tok-function"><span class="mdv-tok"> -</span>l</span> <span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span><span class="mdv-tok"><span class="mdv-tok mdv-tok-function">$</span><span class="mdv-tok mdv-tok-function">f</span></span><span class="mdv-tok mdv-tok-string">&quot;</span></span></span>
<span class="mdv-tok mdv-tok-keyword">done</span>
</span></code></pre>
<pre class="mdv-code" data-lang="json"><code><span class="mdv-tok"><span class="mdv-tok"><span class="mdv-tok">{</span>
  <span class="mdv-tok"><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span>name<span class="mdv-tok mdv-tok-string">&quot;</span></span></span><span class="mdv-tok"><span class="mdv-tok">:</span> <span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span>mdview<span class="mdv-tok mdv-tok-string">&quot;</span></span><span class="mdv-tok">,</span></span>
  <span class="mdv-tok"><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span>version<span class="mdv-tok mdv-tok-string">&quot;</span></span></span><span class="mdv-tok"><span class="mdv-tok">:</span> <span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span>0.1.0<span class="mdv-tok mdv-tok-string">&quot;</span></span><span class="mdv-tok">,</span></span>
  <span class="mdv-tok"><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span>radii<span class="mdv-tok mdv-tok-string">&quot;</span></span></span><span class="mdv-tok"><span class="mdv-tok">:</span> <span class="mdv-tok"><span class="mdv-tok">{</span> <span class="mdv-tok"><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span>sm<span class="mdv-tok mdv-tok-string">&quot;</span></span></span><span class="mdv-tok"><span class="mdv-tok">:</span> <span class="mdv-tok mdv-tok-constant">6</span><span class="mdv-tok">,</span></span> <span class="mdv-tok"><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span>md<span class="mdv-tok mdv-tok-string">&quot;</span></span></span><span class="mdv-tok"><span class="mdv-tok">:</span> <span class="mdv-tok mdv-tok-constant">10</span><span class="mdv-tok">,</span></span> <span class="mdv-tok"><span class="mdv-tok mdv-tok-string"><span class="mdv-tok mdv-tok-string">&quot;</span>lg<span class="mdv-tok mdv-tok-string">&quot;</span></span></span><span class="mdv-tok"><span class="mdv-tok">:</span> <span class="mdv-tok mdv-tok-constant">16</span> </span><span class="mdv-tok">}</span></span>
</span><span class="mdv-tok">}</span></span>
</span></code></pre>
