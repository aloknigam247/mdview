    <span style="color:#c678dd;font-weight:bold;">return</span> <span style="color:#98c379;font-weight:bold;">f</span><span style="color:#98c379;"><span style="color:#98c379;"><span style="color:#98c379;">&quot;</span></span></span><span style="color:#98c379;"><span style="color:#98c379;">hello, </span><span style="color:inherit;"><span style="color:inherit;">{</span><span style="color:inherit;"><span style="color:inherit;"><span style="color:inherit;">name</span></span></span></span><span style="color:inherit;"><span style="color:inherit;">}</span></span><span style="color:#98c379;"><span style="color:#98c379;">&quot;</span></span></span>

<span style="color:inherit;"><span style="color:inherit;"><span style="color:#61afef;">print</span></span><span style="color:inherit;">(</span><span style="color:inherit;"><span style="color:inherit;"><span style="color:inherit;"><span style="color:#61afef;">greet</span></span><span style="color:inherit;">(</span><span style="color:inherit;"><span style="color:#98c379;"><span style="color:#98c379;"><span style="color:#98c379;">&quot;</span></span></span><span style="color:#98c379;"><span style="color:#98c379;">world<span style="color:#98c379;">&quot;</span></span></span></span><span style="color:inherit;">)</span></span></span><span style="color:inherit;">)</span></span>
