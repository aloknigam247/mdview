[38;2;108;112;134m│     let started = std::time::Instant::now();                                                                                                                                                                                                                                                                                                        │[0m
[38;2;108;112;134m│     for ext in registry.html_renderers() { if let Some(out) = ext.render_html(node, ctx) { metrics.record(ext.name(), started.elapsed()); return Ok(Some(out)); } }                                                                                                                                                                                 │[0m
[38;2;108;112;134m│     Ok(None)                                                                                                                                                                                                                                                                                                                                        │[0m
[38;2;108;112;134m│ }                                                                                                                                                                                                                                                                                                                                                   │[0m
