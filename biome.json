{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**/*.{js,mjs,ts}",
      "!!**/artifacts",
      "!!**/dist",
      "!!**/node_modules",
      "!!**/target",
      "!!**/tmp",
      "!!.github/release",
      "!!.worktree",
      "!!crates/mdview-ext-drawio/vendor/drawio-viewer.js",
      "!!crates/mdview-ext-math/assets/vendor/katex.min.js",
      "!!crates/mdview-ext-mermaid/assets/vendor/mermaid.min.js",
      "!!crates/mdview-ext-plotly/assets/vendor/plotly.min.js"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "formatter": {
        "indentWidth": 4
      },
      "includes": ["apps/mdview/webview/**"]
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
