{
  "name": "mdview-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bun-compiled stdin/stdout JSON sidecar that renders mermaid / drawio / plotly sources to SVG for the mdview terminal path.",
  "scripts": {
    "build": "bun build --compile ./src/index.ts --outfile ./mdview-sidecar",
    "test": "bun test"
  },
  "dependencies": {
    "jsdom": "^24.1.0",
    "mermaid": "^11.4.0",
    "plotly.js-dist-min": "^2.35.2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.7.5",
    "bun-types": "^1.1.30",
    "typescript": "^5.6.3"
  }
}
